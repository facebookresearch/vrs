@PACKAGE_INIT@
set(PACKAGE_VERSION "1.0")

# Library setup
set(_VRS_SAVED_CMAKE_MODULE_PATH "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/cmake")
set(VRS_CONFIG_USE_SYSTEM_RAPIDJSON "@VRS_USE_SYSTEM_RAPIDJSON@")
set(VRS_CONFIG_WITH_XPRS "@BUILD_WITH_XPRS@")
include(${CMAKE_CURRENT_LIST_DIR}/cmake/LibrariesSetup.cmake)
set(CMAKE_MODULE_PATH "${_VRS_SAVED_CMAKE_MODULE_PATH}")
unset(_VRS_SAVED_CMAKE_MODULE_PATH)
unset(VRS_CONFIG_USE_SYSTEM_RAPIDJSON)
unset(VRS_CONFIG_WITH_XPRS)

include("${CMAKE_CURRENT_LIST_DIR}/vrslibTargets.cmake")
