{
  "name": "website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "yarn doxydoc && docusaurus build",
    "doxydoc": "/bin/bash -c 'cd .. && mkdir -p \"website/build/doxygen\" && doxygen vrs/Doxyfile'",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "ci": "yarn test:security && yarn lint && yarn prettier:diff",
    "test:security": "node --test test/security-dependencies.test.cjs",
    "lint": "eslint --cache \"**/*.js\" && stylelint \"**/*.css\"",
    "format": "prettier --config .prettierrc --write \"**/*.{js,jsx,ts,tsx,md,mdx}\"",
    "format:diff": "prettier --config .prettierrc --list-different \"**/*.{js,jsx,ts,tsx,md,mdx}\"",
    "prettier": "prettier --config .prettierrc --write \"**/*.{js,jsx,ts,tsx,md,mdx}\"",
    "prettier:diff": "prettier --config .prettierrc --list-different \"**/*.{js,jsx,ts,tsx,md,mdx}\""
  },
  "dependencies": {
    "@algolia/client-search": "^5.23.0",
    "@docusaurus/babel": "^3.10.2",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.0",
    "@svgr/webpack": "^8.1.0",
    "@types/react": "^18.3.3",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "docusaurus-plugin-internaldocs-fb": "^1.19.2",
    "dompurify": "^3.4.17",
    "file-loader": "^6.2.0",
    "micromatch": "^4.0.8",
    "prism-react-renderer": "^1.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-loadable": "^5.5.0",
    "semver": "^6.3.1",
    "url-loader": "^4.1.1",
    "webpack": "^5.112.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.27.0",
    "eslint": "^8.19.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "stylelint": "^16.17.0",
    "typescript": "5.8.2",
    "webpack-dev-server": "^5.2.7"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.15.0",
    "npm": "use yarn instead",
    "yarn": "^1.5"
  },
  "resolutions": {
    "brace-expansion": "1.1.21",
    "image-size": "2.0.4",
    "joi": "17.13.9",
    "js-yaml": "4.3.2",
    "compression": "1.8.2",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.2",
    "tinypool": "2.1.2",
    "shelljs": "^0.8.5",
    "@mdx-js/react": "^3.1.0",
    "ansi-html": "0.0.8",
    "mermaid": "^11.16.1",
    "qs": "6.17.1",
    "diff": "^8.0.3",
    "postcss": "8.5.32",
    "proxy-addr": "2.0.8",
    "websocket-driver": "^0.7.5",
    "source-map-js": "1.2.2",
    "launch-editor": "2.14.2",
    "**/postcss-calc/postcss-selector-parser": "6.1.5",
    "**/postcss-discard-unused/postcss-selector-parser": "6.1.5",
    "**/postcss-merge-rules/postcss-selector-parser": "6.1.5",
    "**/postcss-minify-selectors/postcss-selector-parser": "6.1.5",
    "**/postcss-unique-selectors/postcss-selector-parser": "6.1.5",
    "**/stylehacks/postcss-selector-parser": "6.1.5",
    "postcss-selector-parser": "7.1.7",
    "node-forge": "1.4.3",
    "lodash-es": "4.18.1",
    "**/mermaid/katex": "0.18.2",
    "**/sockjs/uuid": "11.1.1",
    "**/copy-webpack-plugin/serialize-javascript": "7.1.4",
    "**/css-minimizer-webpack-plugin/serialize-javascript": "7.1.4"
  }
}
